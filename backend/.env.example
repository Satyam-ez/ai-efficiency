# Template. Copy to backend/.env and fill in real values. Committed on purpose.
DJANGO_SECRET_KEY=replace-me-with-a-50-char-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:3000

POSTGRES_DB=bugboard
POSTGRES_USER=bugboard
POSTGRES_PASSWORD=replace-me-with-a-strong-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Password given to every seeded person by `manage.py seed_bugboard`.
SEED_USER_PASSWORD=pick-a-dev-password
